  "one_step_full_resolution_rate": "Fraction of root actions for which every public outcome is nonterminal and has a singleton posterior belief.",
  "regret": {
    "information_gap": "expected_latent_upper_bound - observable_upper_bound",
    "decision_gap": "observable_upper_bound - controller_value",
    "total_regret": "expected_latent_upper_bound - controller_value",
    "required_identity": "total_regret = information_gap + decision_gap"
  },
