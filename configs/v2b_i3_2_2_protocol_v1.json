  "utility_semantics": {
    "step_net_utility": "immediate_reward - action_cost + terminal_reward_if_any",
    "action_cost_nonnegative": true,
    "immediate_reward_separate": true,
    "terminal_actions": {
      "ANSWER": "assert a final answer",
      "DEFER": "return an explicit insufficient-evidence result",
      "STOP": "terminate without asserting or deferring"
